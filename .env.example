# ─────────────────────────────────────────────────────────────────────────────
# ReachInbox — environment template.
# Copy to `.env` at the repo root: `cp .env.example .env`, then fill blanks.
# config/env.ts parses this once at boot and THROWS on anything invalid.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode. Controls log verbosity and the `secure` cookie flag.
NODE_ENV=development

# MySQL 8 (see docker-compose.yml). root/root matches the compose defaults.
# Host port is 3307 (not 3306) to avoid clashing with a local MySQL install.
DATABASE_URL=mysql://root:root@localhost:3307/reachinbox

# Redis 7 (see docker-compose.yml). Holds the BullMQ delayed-job sorted set.
# Host port is 6380 (not 6379) to avoid clashing with a local Redis install.
REDIS_URL=redis://localhost:6380

# API (server.ts) HTTP port.
PORT=4000

# HS256 signing secret for the session JWT. Any long random string (>=16 chars).
JWT_SECRET=

# AES-256-GCM key for SMTP passwords at rest. MUST be 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Google OAuth Web client ID. The backend verifies the ID token against this.
GOOGLE_CLIENT_ID=

# Browser origin allowed by CORS (credentials mode). No trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# ── Scheduling / rate-limiting knobs — the ONLY source of tuning values ──────
WORKER_CONCURRENCY=5                  # parallel jobs per worker process
MIN_DELAY_MS_BETWEEN_EMAILS=2000      # min gap between two sends, per sender
MAX_EMAILS_PER_HOUR=200               # global default hourly cap
MAX_EMAILS_PER_HOUR_PER_SENDER=100    # per-sender cap
GLOBAL_MAX_PER_INTERVAL=10            # BullMQ queue-wide limiter: 10 jobs…
GLOBAL_INTERVAL_MS=1000               # …per second
STALE_PROCESSING_THRESHOLD_MS=600000  # PROCESSING→FAILED stranded-claim threshold (reconciler)
MAX_RECIPIENTS_PER_CAMPAIGN=50000
MAX_UPLOAD_BYTES=5242880

# ── Frontend (Next.js) — must be NEXT_PUBLIC_ to reach the browser ───────────
# Mirror GOOGLE_CLIENT_ID here so the login button can request an ID token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
